<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- API Quran.com -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Récitation / microphone (Phase 1) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Lecture modèles ONNX sur stockage externe (Android ≤ 12) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Boussole Qibla : direction vers la Mecque depuis la position actuelle -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Adhan programme (horaires de priere, cf. PrayerNotificationService) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- USE_EXACT_ALARM retiree (2026-08-11, PUBLICATION_PLAY.md §6) : reservee
         par Play aux applications d'alarme/agenda, une app de priere qui la
         demande risque un refus en revue. SCHEDULE_EXACT_ALARM ci-dessus
         suffit (accordable via son formulaire de declaration en console) :
         AdhanSchedulerPlugin.scheduleAlarm() a deja son repli sur une alarme
         INEXACTE (setAndAllowWhileIdle) si la permission n'est pas accordee,
         donc l'adhan sonne toujours, avec un delai possible au lieu de rien.
         NB : pas de double tiret dans ce commentaire, XML l'interdit. -->
    <!-- Lecture reelle de l'adhan complet (AdhanPlaybackService, 2026-08-09) :
         le son de canal de notification ne peut pas jouer un fichier de
         2 min 11 de facon fiable, cf. commentaire du service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Vibreur accompagnant l'adhan (2026-08-11, AdhanPlaybackService.startVibration) :
         permission "normale", accordee automatiquement a l'installation, mais
         DOIT etre declaree ici sinon Vibrator.vibrate() leve une
         SecurityException au moment de sonner. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- SAUVEGARDE AUTOMATIQUE COUPEE (2026-08-10).

         Sans cette ligne, Android considere l'app consentante et copie son
         stockage prive vers le Google Drive de l'utilisateur. Verifie sur
         l'appareil avant correction :
             adb shell dumpsys package com.corankarim.coran_karim
             donne : flags=[ ... ALLOW_BACKUP ... ]

         Ce qui partait ainsi : `recitation_captures/*.wav` (les enregistrements
         de la VOIX de l'utilisateur, dont le service dit lui-meme que « rien ne
         les supprime »), `voice_fingerprints/*.bin` (donnee de nature
         biometrique), `disputed_verdicts/`, les bases SQLite, et le journal de
         diagnostic.

         C'etait la SEULE contradiction directe entre ce que l'app promet et ce
         qu'elle fait : l'ecran « A propos » affirme « Tout se passe sur votre
         telephone » et « votre recitation [...] n'est envoyee nulle part ».
         C'etait vrai du code (l'app n'envoie rien) mais faux du point de vue
         de l'utilisateur, puisque le systeme le faisait a sa place.

         VOLONTAIREMENT `false` PLUTOT QUE DES REGLES D'EXCLUSION : on perd la
         restauration des signets et reglages sur un nouveau telephone, et c'est
         assume. `dataExtractionRules` permettrait de garder ce confort en
         excluant les seuls dossiers de voix, mais une regle mal ecrite
         renverrait la voix en sauvegarde EN SILENCE. Sur une promesse de
         confidentialite, une solution qui ne peut pas echouer vaut mieux
         qu'une solution plus fine qui le peut. A revoir si la restauration
         devient une vraie demande, en traitant alors les DEUX canaux
         (sauvegarde cloud ET transfert d'appareil a appareil).

         NB : pas de « double tiret » dans ce commentaire, XML l'interdit. -->
    <application
        android:label="Coran Karim"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Adhan programme : receivers natifs de flutter_local_notifications.
             ScheduledNotificationBootReceiver reprogramme automatiquement les
             notifications au redemarrage du telephone (aucun code Dart
             supplementaire necessaire pour ca). -->
        <receiver android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
                  android:exported="false" />
        <receiver android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
                  android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Lecture reelle de l'adhan complet (2026-08-09), cf.
             AdhanPlaybackService : remplace le son de canal pour l'adhan
             (toujours utilise par le RAPPEL, un simple bip court, inchange). -->
        <receiver android:name=".adhan.AdhanAlarmReceiver" android:exported="false" />
        <service android:name=".adhan.AdhanPlaybackService"
                 android:exported="false"
                 android:foregroundServiceType="mediaPlayback" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Visibilite du moteur de synthese vocale (Android 11+) pour flutter_tts. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <!-- "Nous contacter" (2026-08-09) : visibilite de l'appli mail pour
             url_launcher (Android 11+ masque les apps non declarees ici). -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>
</manifest>
