  "aboutTagline": "Reciting the Qur'an, checked on your device.",
  "aboutVersionLine": "Version {version} (build {build})",
  "aboutSectionPrivacy": "Your data",
  "aboutPrivacyIntro": "Everything happens on your phone: no account, no ads, no trackers.",
  "aboutPrivacyMic": "Microphone — your recitation is analysed on the device. It is sent elsewhere only if you explicitly agree in Settings, to help improve recognition.",
  "aboutPrivacyLocation": "Location — for the Qibla and prayer times. It stays on the device.",
  "aboutPrivacyDiagnostic": "Diagnostics — when enabled in Settings, audio excerpts and a log are kept on the device. You can delete them at any time.",
  "aboutPrivacyNetwork": "Network — to download the recitations and supplications you ask for, and, if you agreed to it, to send your encrypted sessions over Wi-Fi.",
  "aboutSectionAsr": "What checks your recitation",
  "aboutAsrBody": "An Arabic speech recognition model, trained on recitations, compares what you say against the text. It can be wrong: a flagged word is not always a mistake.",
  "aboutAsrCredit": "Model derived from an NVIDIA model, licensed CC BY 4.0, modified for Qur'anic recitation.",
  "aboutSectionAi": "AI tutor",
  "aboutAiWarning": "Verse explanations are produced by a language model running on your phone. It can be wrong, incomplete or misleading. These texts carry no religious authority: for any question of understanding or jurisprudence, refer to the Qur'an, the Sunnah and qualified scholars.",
  "aboutAiReportTitle": "Report an inappropriate answer",
  "aboutAiReportBody": "Write to us at {email}, mentioning the verse concerned and the text that was shown.",
  "aboutCopied": "Address copied",
  "aboutSectionSources": "Sources",
  "aboutSourceQuran": "Qur'anic text and recitations: Quran.com.",
  "aboutSourceDuas": "Supplication audio: hisnmuslim.com.",
