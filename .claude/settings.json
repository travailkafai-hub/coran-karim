{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/detect-boucle.py\" edit 2>/dev/null || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/exige-superviseur.py\" edit 2>&1 || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/maj-graphe.py\" rappel 2>&1 || true",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/detect-boucle.py\" prompt 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "true  # DESACTIVE 2026-08-05 -- pour reactiver, retirer 'true  # ' : python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde-index-chaine.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "true  # DESACTIVE 2026-08-05 -- pour reactiver, retirer 'true  # ' : python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/exige-superviseur.py\" garde",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "true  # DESACTIVE 2026-08-05 -- pour reactiver, retirer 'true  # ' : python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/maj-graphe.py\" garde",
            "timeout": 15
